# ============================================================================
# BASTI MOTOS — Variables de entorno
# Copia este archivo a .env (local) y configura las mismas claves en Vercel
# (Project Settings -> Environment Variables) antes de desplegar.
#
# NUNCA subas un archivo .env real con credenciales al repositorio.
# ============================================================================

# ---- Base de datos (PostgreSQL) -------------------------------------------
# Privada. Usa una URL "pooled" (ej. pgbouncer de Neon/Supabase) para runtime.
DATABASE_URL="postgresql://usuario:password@host:5432/basti_motos?sslmode=require"
# Privada. URL de conexión DIRECTA (sin pooler), usada solo por `prisma migrate`.
DIRECT_URL="postgresql://usuario:password@host:5432/basti_motos?sslmode=require"

# ---- Auth.js (NextAuth v5) ---------------------------------------------
# Privada. En producción debe ser la URL pública del sitio.
NEXTAUTH_URL="http://localhost:3000"
# Privada. Genera un valor aleatorio: `openssl rand -base64 32`.
NEXTAUTH_SECRET=""

# ---- JWT interno (tokens de verificación / reset, si se usan fuera de Auth.js) ----
# Privada.
JWT_SECRET=""

# ---- Wompi Colombia ------------------------------------------------------
# PÚBLICA: esta es la ÚNICA clave de Wompi que puede llegar al navegador,
# porque el widget/checkout de Wompi la necesita en el cliente para abrir el
# formulario de pago. Debe llevar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY="pub_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Privada. Se usa solo en el servidor para consultar transacciones vía API.
WOMPI_PRIVATE_KEY="prv_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# Privada. NUNCA debe salir del servidor: firma la integridad de cada transacción.
WOMPI_INTEGRITY_SECRET="test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx"
# Privada. Secreto usado para validar la firma de los eventos del webhook.
WOMPI_EVENTS_SECRET="test_events_xxxxxxxxxxxxxxxxxxxxxxxx"
# Privada. URL a la que Wompi redirige tras el pago (debe coincidir con /checkout/resultado).
WOMPI_REDIRECT_URL="http://localhost:3000/checkout/resultado"
# Privada. "sandbox" mientras pruebas, "production" cuando actives tu cuenta real.
WOMPI_ENV="sandbox"

# ---- Cloudinary (imágenes de producto) ------------------------------------
# Privada (se usa para generar firmas de subida en el servidor).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Resend (correos transaccionales) -------------------------------------
# Privada.
RESEND_API_KEY=""
# Privada (remitente verificado en Resend).
EMAIL_FROM="BASTI MOTOS <hola@bastimotos.co>"

# ---- App -------------------------------------------------------------------
# PÚBLICA: se usa para construir enlaces absolutos (correos, sitemap, Wompi redirect).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
