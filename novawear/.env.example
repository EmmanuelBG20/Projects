# ---------------------------------------------------------------------------
# NOVAWEAR — environment variables
# Copy this file to .env and fill in the values you have. Every integration
# below degrades to a clearly-labeled sandbox/mock mode when its variables are
# missing, so the app stays fully runnable with an empty .env.
# ---------------------------------------------------------------------------

# Database — SQLite by default (zero setup). To use PostgreSQL in production,
# change `provider = "sqlite"` to `provider = "postgresql"` in
# prisma/schema.prisma and point this at your managed instance
# (Neon / Supabase / Railway), e.g.
# DATABASE_URL="postgresql://user:password@host:5432/novawear?schema=public"
DATABASE_URL="file:./dev.db"

# Auth.js — required. Generate with: npx auth secret  (or: openssl rand -base64 33)
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Payments ---------------------------------------------------------------
# Colombia: Wompi (cards, PSE, Nequi where supported by the merchant account)
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENV="sandbox" # sandbox | production

# Colombia / LatAm: Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# International: Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Images / storage --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- WhatsApp Business Cloud API --------------------------------------------
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- AI / chatbot -------------------------------------------------------------
# Any one of these enables real tool-calling for the WhatsApp assistant.
# With none set, the assistant runs in rule-based sandbox mode.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="NOVAWEAR <orders@novawear.co>"

# --- Analytics ------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
